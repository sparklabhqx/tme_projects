#!/usr/bin/env bash
set -euo pipefail

ROOT="${HOME}/epaper_projects"
SERVICE="epaper-app.service"
command="${1:-status}"

case "$command" in
  spotify|weather|calendar)
    printf '%s\n' "$command" > "$ROOT/active_app"
    systemctl --user restart "$SERVICE"
    echo "Active e-paper app: $command"
    ;;
  refresh)
    systemctl --user restart "$SERVICE"
    echo "Refreshed: $(cat "$ROOT/active_app")"
    ;;
  stop)
    systemctl --user stop "$SERVICE"
    echo "E-paper app stopped; the last image remains on the panel."
    ;;
  start)
    systemctl --user start "$SERVICE"
    echo "Started: $(cat "$ROOT/active_app")"
    ;;
  status)
    echo "Selected: $(cat "$ROOT/active_app" 2>/dev/null || echo calendar)"
    systemctl --user status "$SERVICE" --no-pager --lines=8 || true
    ;;
  log|logs)
    journalctl --user -u "$SERVICE" -n 40 --no-pager
    ;;
  *)
    echo "Usage: epaper-app {spotify|weather|calendar|refresh|start|stop|status|logs}" >&2
    exit 2
    ;;
esac
